END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{fb7565d4-0f80-4344-9ed9-0617c6e3fe22}" FolderPath="Commands\">
      <Declaration><![CDATA[METHOD Reset : HRESULT
VAR_INPUT
END_VAR
VAR	
	i: INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 0 TO _ResetModuleCount - 1 DO
	IF ResetableModules[i] <> 0 THEN
		ResetableModules[i].Reset();
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Property Name="ResettableModuleCount" Id="{18d47f7d-4c1c-4473-8393-2af5f7b9823d}" FolderPath="Status\">
      <Declaration><![CDATA[PROPERTY ResettableModuleCount : INT]]></Declaration>
      <Get Name="Get" Id="{ab78379d-4236-4650-b3ef-7fb6486e8746}">
