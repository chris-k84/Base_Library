    <Method Name="TraceLevelPropertyReturnsAssignedValue" Id="{5f8ed7aa-c90a-479d-874a-484f30b0e6b5}">
      <Declaration><![CDATA[METHOD TraceLevelPropertyReturnsAssignedValue
VAR
	TestTrace : Trace<1>;
	Expected : TcEventSeverityExt := TcEventSeverityExt.Error;
	Actual	 : TcEventSeverityExt;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TraceTestSuite.Test(__POUNAME()).ExecuteTest() THEN
	TestTrace.TraceLevel := TcEventSeverityExt.Error;
	Actual := TestTrace.TraceLevel;
	TraceTestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
