    <Method Name="InfoForwardsCorrectSeverity" Id="{3ca804f1-4c95-4ae7-b7c4-dadaecd8f86b}">
      <Declaration><![CDATA[METHOD InfoForwardsCorrectSeverity
VAR
	Expected : UINT := 1;
	Actual	 : UINT;
	TestTrace : Trace<1>;
	TestLogger : MockLogger;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TraceTestSuite.Test(__POUNAME()).ExecuteTest() THEN
	TestTrace.TraceLevel := TcEventSeverityExt.Verbose;
	TestTrace.Subscribe(TestLogger);
	TestTrace.Info('TestSource', 'TestMessage');
	Actual := TestLogger.LastSeverity;
	TraceTestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
