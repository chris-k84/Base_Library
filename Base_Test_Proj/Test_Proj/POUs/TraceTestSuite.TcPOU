    </Method>
    <Method Name="MessageSentToAllSubscribedLoggers" Id="{13c53614-96bc-4cbe-93f8-c1a7dddb57c4}">
      <Declaration><![CDATA[METHOD MessageSentToAllSubscribedLoggers
VAR
	Expected : HRESULT := 2;
	Actual	 : HRESULT;
	TestTrace : Trace<2>;
	TestLogger1 : MockLogger;
	TestLogger2 : MockLogger;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TraceTestSuite.Test(__POUNAME()).ExecuteTest() THEN
	TestTrace.TraceLevel := TcEventSeverityExt.Verbose;
	TestTrace.Subscribe(TestLogger1);
	TestTrace.Subscribe(TestLogger2);
	TestTrace.Info('Source', 'Message');
	Actual := TestLogger1.CallCount + TestLogger2.CallCount;
	TraceTestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
