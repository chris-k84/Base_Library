<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="TraceTestSuite" Id="{7af83f1b-e69c-44aa-aa2e-e756b60f4fa4}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK TraceTestSuite
VAR
	TraceTestSuite : TestSuite<TestSuiteParameter.MaxTestCount>(ResultFile := JUnitResultFile) := (TestSuiteName := 'Runner Test Suite');
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[SubscribeAddsLogger();
UnsubscribeRemovesLogger();
TraceLevelPropertyReturnsAssignedValue();
VerboseLogsWhenTraceLevelVerbose();
VerboseDoesNotLogAbovelVerbose();
InfoLogsBelowInfoLevel();
InfoDoesNotLogAboebInfoLevel();
WarningLogsBelowWarningLevel();
WarningDoesNotLogAbovebWarningLevel();
ErrorDoesNotLogAboveErrorLevel();
ErrorLogsBelowErrorLevel();
CriticalLogsAtCriticalLevel();
CriticalLogsBelowCriticalLevel();
MessageSentToAllSubscribedLoggers();
InfoForwardsCorrectSeverity();]]></ST>
    </Implementation>
    <Method Name="CriticalLogsAtCriticalLevel" Id="{070299ee-fb87-4559-a827-871244cffa45}">
      <Declaration><![CDATA[METHOD CriticalLogsAtCriticalLevel
VAR
	Expected : UINT := 1;
	Actual	 : UINT;
	TestTrace : Trace<1>;
	TestLogger : MockLogger;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TraceTestSuite.Test(__POUNAME()).ExecuteTest() THEN
	TestTrace.TraceLevel := TcEventSeverityExt.Critical;
	TestTrace.Subscribe(TestLogger);
	TestTrace.Critical('Source', 'Message');
	Actual := TestLogger.CallCount;
	TraceTestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
